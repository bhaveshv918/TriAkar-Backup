{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.razorpay.com https://*.sentry-cdn.com https://www.googletagmanager.com https://*.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' https://triakar.onrender.com https://*.supabase.co https://*.razorpay.com https://api.postalpincode.in https://nominatim.openstreetmap.org https://*.google-analytics.com https://google-analytics.com https://*.analytics.google.com https://analytics.google.com https://www.google.com https://*.sentry.io https://*.ingest.de.sentry.io https://api.ipify.org https://res.cloudinary.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; worker-src 'self' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; frame-src https://*.razorpay.com https://maps.google.com https://www.google.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "redirects": [
    { "source": "/updates", "destination": "/stories", "permanent": true },
    { "source": "/updates.html", "destination": "/stories", "permanent": true }
  ],
  "rewrites": [
    { "source": "/llm.txt", "destination": "/llms.txt" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/products/([^/]+)", "destination": "/product-detail.html?slug=$1" },
    { "source": "/custom", "destination": "/custom.html" },
    { "source": "/order-confirmation", "destination": "/order-confirmation.html" },
    { "source": "/stories/([^/]+)", "destination": "/story.html?slug=$1" }
  ]
}
