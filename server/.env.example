NODE_ENV=production
PORT=10000
FRONTEND_URL=https://triakar.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
# Webhook secret set in the Razorpay dashboard (Settings → Webhooks).
# Used to verify POST /api/webhooks/razorpay signatures. Optional to boot,
# but required for webhook-driven order confirmation to work.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

RESEND_API_KEY=re_your-resend-key

# Fast2SMS — free OTP SMS for Indian numbers
# Get your key at https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your-fast2sms-api-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
