{
  "manifest_version": 3,
  "name": "Meeting Assistant",
  "version": "1.0",
  "description": "Listens to Google Meet participants and answers questions in real-time",
  "permissions": ["storage", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Assistant"
  }
}
